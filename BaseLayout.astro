---
import '../styles/global.css';
const { title = 'Volle Evangelie Gemeente Jezus is Koning', english = false } = Astro.props;
---
<!doctype html>
<html lang={english ? 'en' : 'nl'}>
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#741d17" /><meta name="description" content="Volle Evangelie Gemeente Jezus is Koning, Paramaribo, Suriname." />
<title>{title}</title>
</head>
<body>
<div class="topline">KOPERSTRAAT #3 · MARETRAITE 4 · PARAMARIBO, SURINAME</div>
<header class="nav">
<a class="brand" href={english ? '/en/' : '/'}><span class="mark">JK</span><span><b>Jezus is Koning</b><small>VOLLE EVANGELIE GEMEENTE</small></span></a>
<nav><a href={english ? '/en/about/' : '/over-ons/'}>{english ? 'About' : 'Over ons'}</a><a href={english ? '/en/ministries/' : '/bedieningen/'}>{english ? 'Ministries' : 'Bedieningen'}</a><a href={english ? '/en/events/' : '/agenda/'}>{english ? 'Events' : 'Agenda'}</a><a href={english ? '/en/sermons/' : '/preken/'}>{english ? 'Sermons' : 'Preken'}</a><a href={english ? '/en/contact/' : '/contact/'}>Contact</a></nav>
<a class="lang" href={english ? '/' : '/en/'}>{english ? 'NL' : 'EN'}</a>
</header>
<slot />
<footer><div class="footer-inner"><div><b>Jezus is Koning</b><p>Volle Evangelie Gemeente</p></div><div><b>{english ? 'Visit us' : 'Bezoek ons'}</b><p>Koperstraat #3, Maretraite 4<br/>Paramaribo, Suriname</p><p>Contact: 8671147</p></div><div><b>MATTHEÜS 6:33</b><p>{english ? "Focused on God's Kingdom." : 'Gericht zijn op Gods Koninkrijk.'}</p></div></div><small>© {new Date().getFullYear()} Volle Evangelie Gemeente Jezus is Koning</small></footer>
</body></html>
